{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["$app/types", "@unplugin-pwa/core/client", "@unplugin-pwa/core/info"]
  },
  "files": ["./frontend/lib/e2/index.d.ts"],
  "include": ["frontend/**/*.ts", "frontend/**/*.js", "frontend/**/*.svelte"],
  "exclude": ["frontend/service-worker.ts"]
}
